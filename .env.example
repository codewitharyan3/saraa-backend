# Copy this file to ".env" and fill in real values.
# Never commit the real ".env" file to any public repository.

PORT=3000

# Get this FREE (no credit card needed) from https://aistudio.google.com
# -> "Get API key" -> "Create API key"
GEMINI_API_KEY=

# Which Gemini model to use. "gemini-flash-lite-latest" is an ALIAS that
# Google keeps pointed at their current lightweight Flash-Lite model — so it
# keeps working even after Google retires/renames specific model versions
# (which happens every few months). This is the recommended, low-maintenance
# default. If you ever want more power (fewer free requests/day, but smarter
# answers), you can try "gemini-flash-latest" instead.
AI_MODEL=gemini-flash-lite-latest
